# =====================================================
# For You Gift Shop - Frontend Environment Variables (Vercel)
# =====================================================

# Backend API base URL.
# IMPORTANT: Must include the /api suffix.
# If unset, the frontend falls back to the hardcoded production URL.
NEXT_PUBLIC_API_URL=https://shop-gx97.onrender.com/api

# InstaPay number shown during checkout (optional - has a code fallback).
# NEXT_PUBLIC_INSTAPAY_NUMBER=+201286153004
