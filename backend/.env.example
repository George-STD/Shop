# =====================================================
# For You Gift Shop - Backend Environment Variables
# =====================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/hadaya

# JWT Authentication (REQUIRED - must be at least 32 characters)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://www.foryo.me,https://foryo.me

# Business Configuration
SHIPPING_COST=95

# Gemini AI (optional - AI features run in fallback mode when missing)
# GEMINI_API_KEY=your_gemini_api_key

# Cloudinary (image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email via Resend HTTP API (SMTP_PASS is the Resend API key)
SMTP_PASS=re_YOUR_RESEND_API_KEY
SMTP_FROM=For You <no-reply@foryo.me>

# InstaPay number shown on checkout/order emails (optional - has a code fallback)
# INSTAPAY_NUMBER=+201286153004

# Resend inbound-email webhook (optional)
# RESEND_WEBHOOK_SECRET=your_webhook_secret

# MongoDB connection tuning (optional)
# MONGO_CONNECT_MAX_RETRIES=5
# MONGO_CONNECT_RETRY_DELAY_MS=5000
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

